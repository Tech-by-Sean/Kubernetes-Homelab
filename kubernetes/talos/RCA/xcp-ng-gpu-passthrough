# Validation
kubectl get pods -n media -w
kubectl exec -n media deployment/jellyfin -- nvidia-smi
kubectl exec -n media deployment/jellyfin -- watch nvidia-smi
kubectl logs -n media deployment/jellyfin | grep -i nvenc
```

